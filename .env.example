# Application
APP_ENV=development
DATA_DIR=./data
DATABASE_URL=sqlite:///./data/tas.db
VECTOR_INDEX_DIR=./data/vector_indexes

# Models (Ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_API_BASE=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:31b
OLLAMA_TIMEOUT_SECONDS=900
# Embedding (Ollama /api/embeddings). TAS_EMBEDDING_MODE=hash 로 강제 해시 가능
EMBEDDING_MODEL=bge-m3
TAS_EMBEDDING_MODE=ollama
# adk | llm | offline
TAS_LLM_MODE=adk
# 1이면 LLM 실패 시 offline 폴백 금지 (스모크/CI용)
TAS_LLM_STRICT=0

# Ingestion
PDF_RENDER_DPI=200
OCR_ENABLED=true

# Review
MAX_REVISIONS=3
